# OpenShelf configuration. Copy to deploy/.env (next to compose.yaml) and edit.
# Every setting is an environment variable; a .env file is just one way to set them.

# --- Required ---------------------------------------------------------------

# Postgres password, used by the postgres service and the default database URL.
# Use URL-safe characters, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-postgres-password

# Encrypts stored account credentials (from v0.2). At least 32 characters in production;
# keep it with your backups, since changing it makes those credentials unreadable.
# Generate with: openssl rand -hex 32
OPENSHELF_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters

# Public URL users reach OpenShelf at, without a trailing slash. An https:// URL
# turns on secure cookies, so set it to your reverse proxy's address.
OPENSHELF_BASE_URL=http://localhost:8080

# --- Optional ---------------------------------------------------------------

# production (default in the image), development, or test. seed only runs outside production.
OPENSHELF_ENV=production

# Run database migrations on startup (default true). If false, run `openshelf migrate` yourself.
OPENSHELF_AUTO_MIGRATE=true

# Postgres connection string. compose.yaml builds one for its own postgres service from
# POSTGRES_PASSWORD; set this only to use an external database.
# OPENSHELF_DATABASE_URL=postgres://openshelf:password@db.example.internal:5432/openshelf?sslmode=require

# Listen address and data directory inside the container. compose.yaml sets these; you
# only need them when running the binary directly.
# OPENSHELF_LISTEN=:8080
# OPENSHELF_DATA_DIR=/data

# Extra request logging (any non-empty value).
# OPENSHELF_DEBUG=1

# Password for `openshelf user create` when not passed with --password. Don't keep it here.
# OPENSHELF_USER_PASSWORD=

# --- Metadata providers (optional; Open Library needs no key) ---------------

# TMDB API read access token, for films and TV: https://www.themoviedb.org/settings/api
OPENSHELF_TMDB_TOKEN=

# IGDB (via Twitch) client credentials, for games: https://api-docs.igdb.com/#account-creation
OPENSHELF_IGDB_CLIENT_ID=
OPENSHELF_IGDB_CLIENT_SECRET=

# Steam Web API key, for Steam library sync: https://steamcommunity.com/dev/apikey
OPENSHELF_STEAM_API_KEY=

# --- compose.yaml only --------------------------------------------------------

# Image to run. Pin a release tag (e.g. ghcr.io/casmith/openshelf:0.1.0) for predictable upgrades.
# OPENSHELF_IMAGE=ghcr.io/casmith/openshelf:latest

# Host port (or host:port, e.g. 127.0.0.1:8080 behind a reverse proxy).
# OPENSHELF_HTTP_PORT=8080

# Reverse proxy addresses (CIDRs or IPs, comma-separated) whose X-Forwarded-For is trusted.
OPENSHELF_TRUSTED_PROXIES=
