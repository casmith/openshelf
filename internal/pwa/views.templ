package pwa

import "github.com/casmith/openshelf/internal/web/ui"

templ offlinePage() {
	@ui.Layout(ui.Page{Title: "Offline"}) {
		<div class="space-y-4 text-center">
			<h1 class="text-2xl font-semibold">You're offline</h1>
			<p class="text-muted">OpenShelf can't reach the server right now. Check your connection and try again.</p>
			@ui.LinkButton("primary", "/") {
				Try again
			}
		</div>
	}
}
