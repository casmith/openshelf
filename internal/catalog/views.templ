package catalog

import (
	"strconv"

	"github.com/casmith/openshelf/internal/db"
	"github.com/casmith/openshelf/internal/images"
	"github.com/casmith/openshelf/internal/web/form"
	"github.com/casmith/openshelf/internal/web/ui"
)

// Matches ui's input styling for inputs that ui.Field can't render (repeated names, htmx).
const inputClass = "block w-full rounded-md border border-line bg-surface px-3 py-2 text-sm placeholder:text-muted focus:border-accent focus:outline-none"

type itemFormData struct {
	Kind db.MediaKind
	Item *db.MediaItem
	Form *form.Form
}

func (d itemFormData) action() string {
	if d.Item != nil {
		return itemURL(*d.Item) + "/edit"
	}
	return "/items"
}

func (d itemFormData) cancel() string {
	if d.Item != nil {
		return itemURL(*d.Item)
	}
	return "/search"
}

func kindTabs(active db.MediaKind) []ui.Tab {
	var tabs []ui.Tab
	for _, k := range kindOrder {
		tabs = append(tabs, ui.Tab{Label: KindLabel(k), Href: "/items/new?kind=" + string(k), Active: k == active})
	}
	return tabs
}

templ messagePage(p ui.Page, title, body string) {
	@ui.Layout(p) {
		@ui.EmptyState(title, body) {
			@ui.LinkButton("secondary", "/search") {
				Back to search
			}
		}
	}
}

templ itemFormPage(p ui.Page, title string, d itemFormData) {
	@ui.Layout(p) {
		@ui.PageHeader(title, "")
		if d.Item == nil {
			@ui.Tabs(kindTabs(d.Kind))
		}
		@ui.Card("max-w-3xl") {
			<form method="post" action={ templ.SafeURL(d.action()) } class="space-y-4">
				@ui.FormErrors(d.Form.Errors)
				<input type="hidden" name="kind" value={ string(d.Kind) }/>
				@ui.Field("title", "Title", d.Form.Values.Get("title"), d.Form.Error("title"), templ.Attributes{"required": true, "autofocus": true, "maxlength": "500"})
				@ui.Field("original_title", "Original title", d.Form.Values.Get("original_title"), d.Form.Error("original_title"), templ.Attributes{})
				<div class="grid gap-4 sm:grid-cols-2">
					@ui.Field("release_date", "Release date", d.Form.Values.Get("release_date"), d.Form.Error("release_date"), templ.Attributes{"type": "date"})
					@ui.Field("release_year", "Release year", d.Form.Values.Get("release_year"), d.Form.Error("release_year"), templ.Attributes{"type": "number", "min": "1000", "max": "3000"})
				</div>
				@ui.Field("genres", "Genres", d.Form.Values.Get("genres"), d.Form.Error("genres"), templ.Attributes{"placeholder": "Comma separated, e.g. rpg, sci-fi"})
				@ui.Textarea("synopsis", "Synopsis", d.Form.Values.Get("synopsis"), d.Form.Error("synopsis"), templ.Attributes{})
				@kindFields(d.Kind, d.Form)
				@creditFields(d.Kind, d.Form)
				<div class="flex gap-2">
					@ui.Button("primary", templ.Attributes{"type": "submit"}) {
						Save
					}
					@ui.LinkButton("ghost", d.cancel()) {
						Cancel
					}
				</div>
			</form>
		}
	}
}

templ kindFields(kind db.MediaKind, f *form.Form) {
	switch kind {
		case db.MediaKindGame:
			@ui.Field("franchise", "Franchise", f.Values.Get("franchise"), f.Error("franchise"), templ.Attributes{})
		case db.MediaKindBook:
			<div class="grid gap-4 sm:grid-cols-[1fr_10rem]">
				@ui.Field("series_name", "Series", f.Values.Get("series_name"), f.Error("series_name"), templ.Attributes{})
				@ui.Field("series_position", "Number in series", f.Values.Get("series_position"), f.Error("series_position"), templ.Attributes{"inputmode": "decimal"})
			</div>
		case db.MediaKindFilm:
			@ui.Field("runtime_minutes", "Runtime (minutes)", f.Values.Get("runtime_minutes"), f.Error("runtime_minutes"), templ.Attributes{"type": "number", "min": "0"})
		case db.MediaKindShow:
			<div class="grid gap-4 sm:grid-cols-2">
				@ui.Field("network", "Network", f.Values.Get("network"), f.Error("network"), templ.Attributes{})
				@ui.Select("status", "Status", f.Values.Get("status"), f.Error("status"), statusOptions(), templ.Attributes{})
				@ui.Field("season_count", "Seasons", f.Values.Get("season_count"), f.Error("season_count"), templ.Attributes{"type": "number", "min": "0"})
				@ui.Field("episode_count", "Episodes", f.Values.Get("episode_count"), f.Error("episode_count"), templ.Attributes{"type": "number", "min": "0"})
			</div>
	}
}

templ creditFields(kind db.MediaKind, f *form.Form) {
	<fieldset>
		<legend class="mb-1 text-sm font-medium">Credits</legend>
		<p class="mb-2 text-xs text-muted">Existing creators are matched by name. Clear a name to remove it.</p>
		<div class="space-y-2">
			for i, row := range creditRows(f, kind) {
				<div class="grid grid-cols-[1fr_10rem] gap-2">
					<input name="credit_name" value={ row.Name } class={ inputClass } aria-label={ "Creator " + strconv.Itoa(i+1) } maxlength="200"/>
					<select name="credit_role" class={ inputClass } aria-label={ "Role " + strconv.Itoa(i+1) }>
						for _, o := range roleOptions(kind) {
							<option value={ o.Value } selected?={ o.Value == row.Role }>{ o.Label }</option>
						}
					</select>
				</div>
			}
		</div>
		if msg := f.Error("credits"); msg != "" {
			<p class="mt-1 text-sm text-danger">{ msg }</p>
		}
	</fieldset>
}

type editionFormData struct {
	Item      db.MediaItem
	Edition   *db.Edition
	Form      *form.Form
	Platforms []db.Platform
}

func (d editionFormData) action() string {
	if d.Edition != nil {
		return itemURL(d.Item) + "/editions/" + d.Edition.PublicID.String() + "/edit"
	}
	return itemURL(d.Item) + "/editions"
}

func platformLabel(p db.Platform) string {
	if p.ShortName != nil && *p.ShortName != p.Name {
		return p.Name + " (" + *p.ShortName + ")"
	}
	return p.Name
}

templ editionFormPage(p ui.Page, title string, d editionFormData) {
	@ui.Layout(p) {
		@ui.PageHeader(title, d.Item.Title)
		@ui.Card("max-w-3xl") {
			<form method="post" action={ templ.SafeURL(d.action()) } class="space-y-4">
				@ui.FormErrors(d.Form.Errors)
				if d.Item.Kind == db.MediaKindGame {
					<div>
						<label for="f-platform_q" class="mb-1 block text-sm font-medium">Platform</label>
						<input
							type="search"
							id="f-platform_q"
							name="platform_q"
							value={ d.Form.Values.Get("platform_q") }
							placeholder="Search platforms, e.g. Mega Drive"
							autocomplete="off"
							class={ inputClass + " mb-2" }
							hx-get={ itemURL(d.Item) + "/editions/platforms" }
							hx-trigger="input changed delay:250ms, search"
							hx-target="#platform-select"
							hx-swap="outerHTML"
							hx-include="#f-platform_id"
						/>
						@platformSelect(d.Platforms, d.Form.Values.Get("platform_id"), d.Form.Error("platform_id"))
					</div>
				}
				@ui.Select("format", "Format", d.Form.Values.Get("format"), d.Form.Error("format"), formatOptions(d.Item.Kind), templ.Attributes{})
				@ui.Field("title", "Edition title", d.Form.Values.Get("title"), d.Form.Error("title"), templ.Attributes{"placeholder": "Leave blank if the same as the item"})
				<div class="grid gap-4 sm:grid-cols-2">
					@ui.Field("region", "Region", d.Form.Values.Get("region"), d.Form.Error("region"), templ.Attributes{"placeholder": "NTSC-U, PAL, JP…"})
					@ui.Field("publisher", "Publisher", d.Form.Values.Get("publisher"), d.Form.Error("publisher"), templ.Attributes{})
					@ui.Field("release_date", "Release date", d.Form.Values.Get("release_date"), d.Form.Error("release_date"), templ.Attributes{"type": "date"})
					if d.Item.Kind == db.MediaKindBook {
						@ui.Field("page_count", "Pages", d.Form.Values.Get("page_count"), d.Form.Error("page_count"), templ.Attributes{"type": "number", "min": "0"})
					}
					if d.Item.Kind != db.MediaKindGame {
						@ui.Field("duration_minutes", "Duration (minutes)", d.Form.Values.Get("duration_minutes"), d.Form.Error("duration_minutes"), templ.Attributes{"type": "number", "min": "0"})
					}
				</div>
				<div class="flex gap-2">
					@ui.Button("primary", templ.Attributes{"type": "submit"}) {
						Save
					}
					@ui.LinkButton("ghost", itemURL(d.Item)) {
						Cancel
					}
				</div>
			</form>
			if d.Edition != nil {
				<form method="post" action={ templ.SafeURL(itemURL(d.Item) + "/editions/" + d.Edition.PublicID.String() + "/delete") } hx-confirm="Delete this edition?" class="mt-6 border-t border-line pt-4">
					@ui.Button("danger", templ.Attributes{"type": "submit"}) {
						@ui.Icon("trash", "h-4 w-4")
						Delete edition
					}
				</form>
			}
		}
	}
}

templ platformSelect(platforms []db.Platform, selected, err string) {
	<div id="platform-select">
		<select id="f-platform_id" name="platform_id" aria-label="Platform" class={ inputClass }>
			<option value="">— No platform —</option>
			for _, p := range platforms {
				<option value={ strconv.FormatInt(p.ID, 10) } selected?={ strconv.FormatInt(p.ID, 10) == selected }>{ platformLabel(p) }</option>
			}
		</select>
		if err != "" {
			<p class="mt-1 text-sm text-danger">{ err }</p>
		}
	</div>
}

type searchData struct {
	Query  string
	Kind   string
	Groups []searchGroup
}

func (d searchData) newItemHref() string {
	href := "/items/new"
	if d.Kind != "" {
		href += "?kind=" + d.Kind
	}
	return href
}

templ searchPage(p ui.Page, d searchData) {
	@ui.Layout(p) {
		@ui.PageHeader("Search", "Find anything in this server's catalog.") {
			@ui.LinkButton("primary", d.newItemHref()) {
				@ui.Icon("plus", "h-4 w-4")
				Add item
			}
		}
		<form method="get" action="/search" role="search" class="mb-6 flex flex-wrap gap-2">
			<input
				type="search"
				name="q"
				value={ d.Query }
				placeholder="Title…"
				aria-label="Search the catalog"
				autofocus
				autocomplete="off"
				class={ inputClass + " max-w-xl flex-1" }
				hx-get="/search"
				hx-trigger="input changed delay:250ms, search"
				hx-target="#search-results"
				hx-include="closest form"
				hx-push-url="true"
			/>
			<select name="kind" aria-label="Kind" class={ inputClass + " w-auto" } hx-get="/search" hx-target="#search-results" hx-include="closest form" hx-push-url="true">
				<option value="">All kinds</option>
				for _, k := range kindOrder {
					<option value={ string(k) } selected?={ string(k) == d.Kind }>{ KindLabel(k) }</option>
				}
			</select>
			@ui.Button("secondary", templ.Attributes{"type": "submit"}) {
				Search
			}
		</form>
		@searchResults(d)
	}
}

templ searchResults(d searchData) {
	<div id="search-results">
		if d.Query == "" {
			<p class="text-sm text-muted">Type a title to search.</p>
		} else if len(d.Groups) == 0 {
			@ui.EmptyState("No matches", "Nothing in the catalog matches “"+d.Query+"”.") {
				@ui.LinkButton("primary", d.newItemHref()) {
					Add it manually
				}
			}
		} else {
			for _, g := range d.Groups {
				<section class="mb-8">
					<h2 class="mb-3 flex items-center gap-2 text-lg font-semibold">
						@ui.KindIcon(string(g.Kind), "h-5 w-5")
						{ KindLabel(g.Kind) }
					</h2>
					@ui.CoverGrid() {
						for _, it := range g.Items {
							@ui.CoverCard(ui.CoverCardProps{
								Href:     "/items/" + it.PublicID.String(),
								Title:    it.Title,
								Subtitle: yearLabel(it.ReleaseYear),
								CoverURL: images.CoverURL(it.CoverImageID, it.Kind, images.Card),
								Kind:     string(it.Kind),
							})
						}
					}
				</section>
			}
		}
	</div>
}

func yearLabel(y *int16) string {
	if y == nil {
		return ""
	}
	return strconv.Itoa(int(*y))
}
