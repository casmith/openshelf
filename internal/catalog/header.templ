package catalog

import (
	"strconv"
	"strings"

	"github.com/casmith/openshelf/internal/db"
	"github.com/casmith/openshelf/internal/images"
	"github.com/casmith/openshelf/internal/web/ui"
)

func creditLine(credits []db.ListCreditsForItemsRow) string {
	var names []string
	for _, c := range credits {
		if c.Role == db.CreditRoleAuthor || c.Role == db.CreditRoleDirector || c.Role == db.CreditRoleDeveloper || c.Role == db.CreditRoleCreator {
			names = append(names, c.Name)
		}
	}
	return strings.Join(names, ", ")
}

func editionLabel(e db.ListEditionsForItemRow) string {
	var parts []string
	if e.PlatformName != nil {
		parts = append(parts, *e.PlatformName)
	}
	if e.Format != nil {
		parts = append(parts, strings.ReplaceAll(string(*e.Format), "_", " "))
	}
	if e.Region != nil {
		parts = append(parts, *e.Region)
	}
	if e.ReleaseDate != nil {
		parts = append(parts, strconv.Itoa(e.ReleaseDate.Year()))
	}
	if e.Title != nil {
		parts = append([]string{*e.Title}, parts...)
	}
	if len(parts) == 0 {
		return "Edition"
	}
	return strings.Join(parts, " · ")
}

templ header(h headerData) {
	<div class="flex flex-col gap-6 sm:flex-row">
		<img src={ images.CoverURL(h.Item.CoverImageID, h.Item.Kind, images.Card) } alt="" class="aspect-[2/3] w-40 shrink-0 self-start rounded-md border border-line object-cover sm:w-48"/>
		<div class="min-w-0 flex-1">
			<p class="flex items-center gap-1.5 text-sm text-muted">
				@ui.KindIcon(string(h.Item.Kind), "h-4 w-4")
				{ KindLabel(h.Item.Kind) }
				if h.Item.ReleaseYear != nil {
					<span>· { strconv.Itoa(int(*h.Item.ReleaseYear)) }</span>
				}
			</p>
			<h1 class="mt-1 text-3xl font-semibold">{ h.Item.Title }</h1>
			if line := creditLine(h.Credits); line != "" {
				<p class="mt-1 text-muted">{ line }</p>
			}
			if len(h.Item.Genres) > 0 {
				<div class="mt-3 flex flex-wrap gap-1.5">
					for _, g := range h.Item.Genres {
						@ui.Badge(g)
					}
				</div>
			}
			if h.Item.Synopsis != nil {
				<p class="mt-4 max-w-prose whitespace-pre-line text-sm leading-relaxed">{ *h.Item.Synopsis }</p>
			}
			if len(h.Editions) > 0 {
				<div class="mt-4">
					<h2 class="text-sm font-medium text-muted">Editions</h2>
					<ul class="mt-1 space-y-0.5 text-sm">
						for _, e := range h.Editions {
							<li>{ editionLabel(e) }</li>
						}
					</ul>
				</div>
			}
		</div>
	</div>
}
