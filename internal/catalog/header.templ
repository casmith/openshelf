package catalog

import (
	"strconv"
	"strings"

	"github.com/casmith/openshelf/internal/db"
	"github.com/casmith/openshelf/internal/images"
	"github.com/casmith/openshelf/internal/web/ui"
)

type headerData struct {
	Item     db.MediaItem
	Details  ItemInput
	Editions []db.ListEditionsForItemRow
	CanEdit  bool
}

func isPrimaryRole(r db.CreditRole) bool {
	return r == db.CreditRoleAuthor || r == db.CreditRoleDirector || r == db.CreditRoleDeveloper || r == db.CreditRoleCreator
}

func creditLine(credits []CreditInput) string {
	var names []string
	for _, c := range credits {
		if isPrimaryRole(c.Role) {
			names = append(names, c.Name)
		}
	}
	return strings.Join(names, ", ")
}

type fact struct{ Label, Value string }

func itemFacts(in ItemInput) []fact {
	var out []fact
	add := func(label, v string) {
		if v != "" {
			out = append(out, fact{label, v})
		}
	}
	add("Original title", str(in.OriginalTitle))
	add("Franchise", str(in.Franchise))
	if in.SeriesName != nil {
		s := *in.SeriesName
		if in.SeriesPosition != nil {
			s += " #" + floatStr(in.SeriesPosition)
		}
		add("Series", s)
	}
	if in.RuntimeMinutes != nil {
		add("Runtime", num(in.RuntimeMinutes)+" min")
	}
	add("Network", str(in.Network))
	if in.Status != nil {
		add("Status", capitalize(*in.Status))
	}
	add("Seasons", num(in.SeasonCount))
	add("Episodes", num(in.EpisodeCount))
	for _, c := range in.Credits {
		if !isPrimaryRole(c.Role) {
			add(capitalize(string(c.Role)), c.Name)
		}
	}
	return out
}

func editionLabel(e db.ListEditionsForItemRow) string {
	var parts []string
	if e.PlatformName != nil {
		parts = append(parts, *e.PlatformName)
	}
	if e.Format != nil {
		parts = append(parts, formatLabel(*e.Format))
	}
	if e.Region != nil {
		parts = append(parts, *e.Region)
	}
	if e.ReleaseDate != nil {
		parts = append(parts, strconv.Itoa(e.ReleaseDate.Year()))
	}
	if e.Title != nil {
		parts = append([]string{*e.Title}, parts...)
	}
	if len(parts) == 0 {
		return "Edition"
	}
	return strings.Join(parts, " · ")
}

templ header(h headerData) {
	<div class="flex flex-col gap-6 sm:flex-row">
		<a href={ templ.SafeURL(itemURL(h.Item) + "/cover") } class="shrink-0 self-start" title="Cover">
			<img src={ images.CoverURL(h.Item.CoverImageID, h.Item.Kind, images.Card) } alt={ "Cover of " + h.Item.Title } class="aspect-[2/3] w-40 rounded-md border border-line object-cover sm:w-48"/>
		</a>
		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div class="min-w-0">
					<p class="flex items-center gap-1.5 text-sm text-muted">
						@ui.KindIcon(string(h.Item.Kind), "h-4 w-4")
						{ KindLabel(h.Item.Kind) }
						if h.Item.ReleaseYear != nil {
							<span>· { strconv.Itoa(int(*h.Item.ReleaseYear)) }</span>
						}
					</p>
					<h1 class="mt-1 text-3xl font-semibold">{ h.Item.Title }</h1>
					if line := creditLine(h.Details.Credits); line != "" {
						<p class="mt-1 text-muted">{ line }</p>
					}
				</div>
				if h.CanEdit {
					@ui.LinkButton("secondary", itemURL(h.Item)+"/edit") {
						@ui.Icon("edit", "h-4 w-4")
						Edit
					}
				}
			</div>
			if len(h.Item.Genres) > 0 {
				<div class="mt-3 flex flex-wrap gap-1.5">
					for _, g := range h.Item.Genres {
						@ui.Badge(g)
					}
				</div>
			}
			if h.Item.Synopsis != nil {
				<p class="mt-4 max-w-prose whitespace-pre-line text-sm leading-relaxed">{ *h.Item.Synopsis }</p>
			}
			if facts := itemFacts(h.Details); len(facts) > 0 {
				<dl class="mt-4 grid max-w-prose grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
					for _, f := range facts {
						<dt class="text-muted">{ f.Label }</dt>
						<dd>{ f.Value }</dd>
					}
				</dl>
			}
			if len(h.Editions) > 0 || h.CanEdit {
				<div class="mt-4">
					<h2 class="text-sm font-medium text-muted">Editions</h2>
					<ul class="mt-1 space-y-0.5 text-sm">
						for _, e := range h.Editions {
							<li class="flex items-center gap-2">
								<span>{ editionLabel(e) }</span>
								if h.CanEdit {
									<a href={ templ.SafeURL(itemURL(h.Item) + "/editions/" + e.PublicID.String() + "/edit") } class="text-muted hover:text-accent" aria-label={ "Edit " + editionLabel(e) }>
										@ui.Icon("edit", "h-3.5 w-3.5")
									</a>
								}
							</li>
						}
					</ul>
					if h.CanEdit {
						<a href={ templ.SafeURL(itemURL(h.Item) + "/editions/new") } class="mt-2 inline-flex items-center gap-1 text-sm text-accent hover:underline">
							@ui.Icon("plus", "h-3.5 w-3.5")
							Add edition
						</a>
					}
				</div>
			}
		</div>
	</div>
}
