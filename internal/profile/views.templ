package profile

import (
	"strconv"

	"github.com/google/uuid"

	"github.com/casmith/openshelf/internal/catalog"
	"github.com/casmith/openshelf/internal/db"
	"github.com/casmith/openshelf/internal/images"
	"github.com/casmith/openshelf/internal/journal"
	"github.com/casmith/openshelf/internal/reviews"
	"github.com/casmith/openshelf/internal/web/ui"
)

func kindTabs(p profileData) []ui.Tab {
	tabs := []ui.Tab{{Label: "All", Href: p.href(nil, nil), Active: p.Kind == nil}}
	for _, n := range ui.LibraryNav {
		k := db.MediaKind(n.Key)
		tabs = append(tabs, ui.Tab{Label: n.Label, Href: p.href(&k, nil), Active: p.Kind != nil && *p.Kind == k})
	}
	return tabs
}

func status(r db.ProfileInProgressRow) string {
	if pr := progress(r.ProgressUnit, r.ProgressCurrent, r.ProgressTotal); pr != "" {
		return pr
	}
	doing := journal.Doing(r.Kind)
	return string(doing[0]-'a'+'A') + doing[1:]
}

func chip(r db.ProfileInProgressRow) string {
	if r.State == db.ExperienceStatePaused {
		return "Paused"
	}
	return ""
}

func stateLabel(s db.ExperienceState) string {
	if s == db.ExperienceStatePaused {
		return "Paused"
	}
	return "Abandoned"
}

func visibilityLabel(v db.Visibility) string {
	switch v {
	case db.VisibilityInstance:
		return "Instance"
	case db.VisibilityPublic:
		return "Public"
	}
	return "Private"
}

templ page(pg ui.Page, p profileData) {
	@ui.Layout(pg) {
		@header(p)
		@ui.Tabs(kindTabs(p))
		if !p.Own && p.empty() {
			@ui.EmptyState("Nothing shared yet", p.Owner.DisplayName+" hasn't shared anything here.")
		}
		if len(p.InProgress) > 0 || p.Own {
			@section("in-progress", "In progress") {
				if len(p.InProgress) == 0 {
					@ui.EmptyState("Nothing in progress", "")
				} else {
					@ui.CoverGrid() {
						for _, r := range p.InProgress {
							@ui.CoverCard(ui.CoverCardProps{
								Href:     journal.ItemHref(r.PublicID),
								Title:    r.Title,
								Subtitle: status(r),
								CoverURL: images.CoverURL(r.CoverImageID, r.Kind, images.Card),
								Kind:     string(r.Kind),
								Chip:     chip(r),
							})
						}
					}
				}
			}
		}
		if len(p.Completed.Years) > 0 || p.Own {
			@section("completed", "Completed") {
				if len(p.Completed.Years) == 0 {
					@ui.EmptyState("Nothing completed yet", "")
				} else {
					@completedPage(p)
				}
			}
		}
		if len(p.Backlog) > 0 || p.Own {
			@section("backlog", "Backlog") {
				if len(p.Backlog) == 0 {
					@ui.EmptyState("Backlog is empty", "")
				} else {
					<p class="-mt-2 mb-4 text-sm text-muted">
						if p.Counts.Backlog > int64(len(p.Backlog)) {
							Showing { strconv.Itoa(len(p.Backlog)) } of { count(p.Counts.Backlog) }
						} else {
							{ plural(p.Counts.Backlog, "item", "items") }
						}
					</p>
					@ui.CoverGrid() {
						for _, b := range p.Backlog {
							@ui.CoverCard(ui.CoverCardProps{
								Href:     journal.ItemHref(b.PublicID),
								Title:    b.Title,
								Subtitle: catalog.KindLabel(b.Kind),
								CoverURL: images.CoverURL(b.CoverImageID, b.Kind, images.Card),
								Kind:     string(b.Kind),
							})
						}
					}
				}
			}
		}
		if len(p.Stalled) > 0 || p.Own {
			@section("stalled", "Paused and abandoned") {
				if len(p.Stalled) == 0 {
					@ui.EmptyState("Nothing paused or abandoned", "")
				} else {
					<ul class="divide-y divide-line rounded-lg border border-line bg-surface">
						for _, s := range p.Stalled {
							<li class="flex items-center gap-3 px-4 py-2 text-sm" data-section="stalled">
								@ui.KindIcon(string(s.Kind), "h-4 w-4 text-muted")
								<a href={ templ.SafeURL(journal.ItemHref(s.PublicID)) } class="min-w-0 flex-1 truncate font-medium hover:text-accent">{ s.Title }</a>
								@ui.Badge(stateLabel(s.State))
								<span class="text-xs text-muted">{ s.Day.Format("Jan 2, 2006") }</span>
							</li>
						}
					</ul>
				}
			}
		}
		if len(p.Reviews) > 0 || p.Own {
			@section("reviews", "Recent reviews") {
				if len(p.Reviews) == 0 {
					@ui.EmptyState("No reviews yet", "")
				} else {
					<ul class="space-y-4">
						for _, r := range p.Reviews {
							<li class="rounded-lg border border-line bg-surface p-4" data-section="reviews">
								<p class="flex flex-wrap items-center gap-2 text-sm">
									@ui.KindIcon(string(r.ItemKind), "h-4 w-4 text-muted")
									<a href={ templ.SafeURL("/reviews/" + r.Review.PublicID.String()) } class="font-medium hover:text-accent">{ r.ItemTitle }</a>
									@reviews.RatingDisplay(p.Display, r.Review.Rating)
									<span class="ml-auto text-xs text-muted">{ r.Review.UpdatedAt.Format("Jan 2, 2006") }</span>
								</p>
								@reviews.Body(r.Review)
							</li>
						}
					</ul>
				}
			}
		}
		if len(p.Lists) > 0 || p.Own {
			@section("lists", "Lists") {
				if len(p.Lists) == 0 {
					@ui.EmptyState("No lists yet", "")
				} else {
					<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
						for _, l := range p.Lists {
							<li data-section="lists">
								<a href={ templ.SafeURL("/lists/" + l.PublicID.String()) } class="block rounded-lg border border-line bg-surface px-4 py-3 hover:border-accent">
									<p class="truncate font-medium">{ l.Name }</p>
									<p class="text-xs text-muted">
										{ plural(l.ItemCount, "item", "items") }
										if l.Ranked {
											· Ranked
										}
										if p.Own {
											· { visibilityLabel(l.Visibility) }
										}
									</p>
								</a>
							</li>
						}
					</ul>
				}
			}
		}
	}
}

templ header(p profileData) {
	<div class="mb-6">
		<div class="flex items-center gap-4">
			<div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-accent/15 text-2xl font-semibold text-accent" aria-hidden="true">
				{ initial(p.Owner.DisplayName) }
			</div>
			<div class="min-w-0">
				<h1 class="truncate text-2xl font-semibold">{ p.Owner.DisplayName }</h1>
				<p class="text-sm text-muted">
					{ "@" + p.Owner.Username } · Member since { p.Owner.CreatedAt.In(journal.Location(p.Owner)).Format("January 2006") }
				</p>
			</div>
		</div>
		if p.Own {
			<p class="mt-3 text-sm text-muted" id="visibility-note">
				Others only see items marked “instance” or “public”.
				<a href="/settings" class="text-accent hover:underline">Change your default visibility</a>
			</p>
		}
		<ul class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4" aria-label="Profile summary">
			@counter("completed", "Completed", p.Counts.Completed)
			@counter("in-progress", "In progress", p.Counts.InProgress)
			@counter("backlog", "Backlog", p.Counts.Backlog)
			@counter("abandoned", "Abandoned", p.Counts.Abandoned)
		</ul>
	</div>
}

func initial(name string) string {
	for _, r := range name {
		return string(r)
	}
	return "?"
}

templ counter(id, label string, n int64) {
	<li class="rounded-lg border border-line bg-surface p-4">
		<p class="text-2xl font-semibold" id={ "count-" + id }>{ count(n) }</p>
		<p class="text-sm text-muted">{ label }</p>
	</li>
}

templ section(id, title string) {
	<section class="mb-8" id={ id }>
		<h2 class="mb-4 text-lg font-semibold">{ title }</h2>
		{ children... }
	</section>
}

// completedPage is one keyset page of completions; the "more" link swaps itself for the next page.
templ completedPage(p profileData) {
	for i, g := range p.Completed.Years {
		<div class="mb-6" data-year={ strconv.Itoa(int(g.Year)) }>
			if i > 0 || !p.Completed.ContinuesYear {
				<h3 class="mb-3 text-sm font-semibold text-muted">{ strconv.Itoa(int(g.Year)) }</h3>
			}
			@ui.CoverGrid() {
				for _, c := range g.Items {
					@completedCard(c, p.Display)
				}
			}
		</div>
	}
	if n := p.Completed.Next; n != nil {
		<a
			href={ templ.SafeURL(p.href(p.Kind, n) + "#completed") }
			hx-get={ p.href(p.Kind, n) }
			hx-target="this"
			hx-swap="outerHTML"
			class="inline-flex items-center gap-1 text-sm text-accent hover:underline"
			id="more-completions"
		>
			All completions
			@ui.Icon("down", "h-4 w-4")
		</a>
	}
}

templ completedCard(c db.ProfileCompletedRow, display db.RatingDisplay) {
	<li data-section="completed">
		@cover(c.PublicID, c.Kind, c.Title, c.CoverImageID)
		<p class="flex items-center gap-1.5 text-xs text-muted">
			@ui.KindIcon(string(c.Kind), "h-3.5 w-3.5")
			<span>{ c.LastDay.Format("Jan 2") }</span>
			if c.Times > 1 {
				<span data-times>
					@ui.Badge("×" + strconv.Itoa(int(c.Times)))
				</span>
			}
			<span class="ml-auto">
				@reviews.RatingDisplay(display, c.Rating)
			</span>
		</p>
	</li>
}

templ cover(id uuid.UUID, kind db.MediaKind, title string, imageID *int64) {
	<a href={ templ.SafeURL(journal.ItemHref(id)) } class="group block">
		<div class="aspect-[2/3] overflow-hidden rounded-md border border-line bg-surface-2">
			<img src={ images.CoverURL(imageID, kind, images.Card) } alt="" loading="lazy" class="h-full w-full object-cover transition group-hover:scale-[1.02]"/>
		</div>
		<p class="mt-2 truncate text-sm font-medium group-hover:text-accent">{ title }</p>
	</a>
}
