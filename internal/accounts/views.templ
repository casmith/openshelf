package accounts

import (
	"github.com/casmith/openshelf/internal/db"
	"github.com/casmith/openshelf/internal/web/form"
	"github.com/casmith/openshelf/internal/web/static"
	"github.com/casmith/openshelf/internal/web/ui"
)

const smallBtn = "inline-flex h-8 items-center rounded-md border border-line bg-surface px-2 text-xs text-muted hover:bg-surface-2 hover:text-fg"

var visibilityOptions = []ui.Option{
	{Value: string(db.VisibilityPrivate), Label: "Only me"},
	{Value: string(db.VisibilityInstance), Label: "Everyone on this server"},
	{Value: string(db.VisibilityPublic), Label: "Public"},
}

var ratingOptions = []ui.Option{
	{Value: string(db.RatingDisplayStars5), Label: "5 stars (half stars allowed)"},
	{Value: string(db.RatingDisplayTen), Label: "1–10"},
	{Value: string(db.RatingDisplayHundred), Label: "1–100"},
}

func timezoneOptions(current string) []ui.Option {
	opts := make([]ui.Option, 0, len(Timezones)+1)
	found := false
	for _, tz := range Timezones {
		opts = append(opts, ui.Option{Value: tz, Label: tz})
		found = found || tz == current
	}
	if !found && ValidTimezone(current) {
		opts = append([]ui.Option{{Value: current, Label: current}}, opts...)
	}
	return opts
}

func emailOf(u db.User) string {
	if u.Email != nil {
		return *u.Email
	}
	return "—"
}

func userPath(u db.User, op string) string { return "/admin/users/" + u.Username + "/" + op }

templ setupPage(p ui.Page, f *form.Form) {
	@ui.Layout(p) {
		<div class="mb-8 flex flex-col items-center gap-3 text-center">
			<img src={ static.URL("logo.svg") } alt="" class="h-12 w-12"/>
			<h1 class="text-2xl font-semibold">Welcome to OpenShelf</h1>
			<p class="text-sm text-muted">Create the first account. It will be the administrator.</p>
		</div>
		@ui.Card("") {
			<form method="post" action="/setup" class="space-y-4" hx-boost="false">
				@ui.FormErrors(f.Errors)
				@ui.Field("username", "Username", f.Values.Get("username"), f.Error("username"), templ.Attributes{"autocomplete": "username", "required": true, "autofocus": true, "pattern": "[a-z0-9_]{2,30}"})
				<p class="-mt-2 text-xs text-muted">Lowercase letters, digits, and underscores. Usernames can't be changed later.</p>
				@ui.Field("display_name", "Display name", f.Values.Get("display_name"), f.Error("display_name"), templ.Attributes{"autocomplete": "name"})
				@ui.Field("email", "Email (optional)", f.Values.Get("email"), f.Error("email"), templ.Attributes{"type": "email", "autocomplete": "email"})
				@ui.Field("password", "Password", "", f.Error("password"), templ.Attributes{"type": "password", "autocomplete": "new-password", "required": true, "minlength": "8"})
				@ui.Field("password_confirm", "Confirm password", "", f.Error("password_confirm"), templ.Attributes{"type": "password", "autocomplete": "new-password", "required": true})
				@ui.Button("primary", templ.Attributes{"type": "submit"}) {
					Create admin account
				}
			</form>
		}
		<p class="mt-6 text-center text-sm text-muted">
			Already set up? <a href="/login" class="text-accent hover:underline">Sign in</a>
		</p>
	}
}

templ setupDonePage(p ui.Page, providers []providerStatus) {
	@ui.Layout(p) {
		@ui.PageHeader("You're all set", "Your admin account is ready.")
		@ui.Card("max-w-2xl") {
			<h2 class="mb-1 font-semibold">Metadata providers</h2>
			<p class="mb-4 text-sm text-muted">
				Provider keys come from <code>OPENSHELF_*</code> environment variables. Set them however you deploy OpenShelf, then restart it.
			</p>
			@providerTable(providers)
			<div class="mt-6 flex gap-2">
				@ui.LinkButton("primary", "/") {
					Continue to OpenShelf
				}
				@ui.LinkButton("secondary", "/admin/users") {
					Add users
				}
			</div>
		}
	}
}

templ providerTable(providers []providerStatus) {
	@ui.Table() {
		<thead>
			<tr><th>Provider</th><th>Used for</th><th>Environment</th><th>Status</th></tr>
		</thead>
		<tbody>
			for _, s := range providers {
				<tr data-provider={ s.Label }>
					<td class="font-medium">{ s.Label }</td>
					<td class="text-muted">{ s.Kinds }</td>
					<td><code class="text-xs">{ s.Env }</code></td>
					<td>
						if s.Configured {
							<span class="text-success" data-configured="true">Configured</span>
						} else {
							<span class="text-muted" data-configured="false">Not configured</span>
						}
					</td>
				</tr>
			}
		</tbody>
	}
}

templ settingsPage(p ui.Page, s settingsData) {
	@ui.Layout(p) {
		@ui.PageHeader("Settings", "Signed in as @"+s.User.Username) {
			if s.User.Role == db.UserRoleAdmin {
				@ui.LinkButton("secondary", "/admin/users") {
					@ui.Icon("user", "h-4 w-4")
					Manage users
				}
			}
		}
		<div class="grid max-w-2xl gap-6">
			@ui.Card("") {
				<h2 id="profile" class="mb-4 font-semibold">Profile</h2>
				<form method="post" action="/settings/profile" class="space-y-4" hx-boost="false">
					@ui.FormErrors(s.Profile.Errors)
					@ui.Field("username", "Username", s.User.Username, "", templ.Attributes{"disabled": true})
					@ui.Field("display_name", "Display name", s.Profile.Values.Get("display_name"), s.Profile.Error("display_name"), templ.Attributes{"required": true, "maxlength": "100", "autocomplete": "name"})
					@ui.Field("email", "Email", s.Profile.Values.Get("email"), s.Profile.Error("email"), templ.Attributes{"type": "email", "autocomplete": "email"})
					@ui.Button("primary", templ.Attributes{"type": "submit"}) {
						Save profile
					}
				</form>
			}
			@ui.Card("") {
				<h2 id="password" class="mb-4 font-semibold">Password</h2>
				<form method="post" action="/settings/password" class="space-y-4" hx-boost="false">
					@ui.FormErrors(s.Password.Errors)
					@ui.Field("current_password", "Current password", "", s.Password.Error("current_password"), templ.Attributes{"type": "password", "autocomplete": "current-password", "required": true})
					@ui.Field("new_password", "New password", "", s.Password.Error("new_password"), templ.Attributes{"type": "password", "autocomplete": "new-password", "required": true, "minlength": "8"})
					@ui.Field("new_password_confirm", "Confirm new password", "", s.Password.Error("new_password_confirm"), templ.Attributes{"type": "password", "autocomplete": "new-password", "required": true})
					@ui.Button("primary", templ.Attributes{"type": "submit"}) {
						Change password
					}
				</form>
			}
			@ui.Card("") {
				<h2 id="preferences" class="mb-4 font-semibold">Preferences</h2>
				<form method="post" action="/settings/preferences" class="space-y-4" hx-boost="false">
					@ui.FormErrors(s.Pref.Errors)
					@ui.Select("default_visibility", "Default visibility for new entries", s.Pref.Values.Get("default_visibility"), s.Pref.Error("default_visibility"), visibilityOptions, nil)
					@ui.Select("rating_display", "Rating scale", s.Pref.Values.Get("rating_display"), s.Pref.Error("rating_display"), ratingOptions, nil)
					@ui.Select("timezone", "Time zone", s.Pref.Values.Get("timezone"), s.Pref.Error("timezone"), timezoneOptions(s.Pref.Values.Get("timezone")), nil)
					@ui.Button("primary", templ.Attributes{"type": "submit"}) {
						Save preferences
					}
				</form>
			}
			@ui.Card("") {
				<h2 id="data" class="mb-2 font-semibold">Your data</h2>
				<p class="mb-4 text-sm text-muted">Download everything you've tracked, or bring in data from a file.</p>
				<div class="flex flex-wrap gap-2">
					@ui.LinkButton("secondary", "/settings/export") {
						@ui.Icon("download", "h-4 w-4")
						Export
					}
					@ui.LinkButton("secondary", "/settings/import") {
						@ui.Icon("plus", "h-4 w-4")
						Import
					}
				</div>
			}
		</div>
	}
}

templ adminUsersPage(p ui.Page, me db.User, users []db.User) {
	@ui.Layout(p) {
		@ui.PageHeader("Users", "Accounts on this server.") {
			@ui.LinkButton("primary", "/admin/users/new") {
				@ui.Icon("plus", "h-4 w-4")
				New user
			}
		}
		@ui.Table() {
			<thead>
				<tr><th>User</th><th>Email</th><th>Role</th><th>Status</th><th class="text-right">Actions</th></tr>
			</thead>
			<tbody>
				for _, u := range users {
					<tr data-user={ u.Username }>
						<td>
							<p class="font-medium">{ u.DisplayName }</p>
							<p class="text-xs text-muted">{ "@" + u.Username }</p>
						</td>
						<td class="text-muted">{ emailOf(u) }</td>
						<td>
							@ui.Badge(string(u.Role))
						</td>
						<td>
							if u.DisabledAt != nil {
								<span class="text-danger">Disabled</span>
							} else {
								Active
							}
						</td>
						<td>
							<div class="flex flex-wrap justify-end gap-1">
								<form method="post" action={ templ.SafeURL(userPath(u, "role")) } hx-boost="false">
									if u.Role == db.UserRoleAdmin {
										<input type="hidden" name="role" value="member"/>
										<button class={ smallBtn }>Make member</button>
									} else {
										<input type="hidden" name="role" value="admin"/>
										<button class={ smallBtn }>Make admin</button>
									}
								</form>
								if u.ID != me.ID {
									if u.DisabledAt != nil {
										<form method="post" action={ templ.SafeURL(userPath(u, "enable")) } hx-boost="false">
											<button class={ smallBtn }>Enable</button>
										</form>
									} else {
										<form method="post" action={ templ.SafeURL(userPath(u, "disable")) } hx-boost="false">
											<button class={ smallBtn }>Disable</button>
										</form>
									}
								}
								<form method="post" action={ templ.SafeURL(userPath(u, "reset-password")) } hx-boost="false">
									<button class={ smallBtn }>Reset password</button>
								</form>
							</div>
						</td>
					</tr>
				}
			</tbody>
		}
	}
}

templ adminNewUserPage(p ui.Page, f *form.Form) {
	@ui.Layout(p) {
		@ui.PageHeader("New user", "A temporary password is shown once after you create the account.")
		@ui.Card("max-w-lg") {
			<form method="post" action="/admin/users" class="space-y-4" hx-boost="false">
				@ui.FormErrors(f.Errors)
				@ui.Field("username", "Username", f.Values.Get("username"), f.Error("username"), templ.Attributes{"required": true, "autofocus": true, "pattern": "[a-z0-9_]{2,30}"})
				@ui.Field("display_name", "Display name", f.Values.Get("display_name"), f.Error("display_name"), nil)
				@ui.Field("email", "Email (optional)", f.Values.Get("email"), f.Error("email"), templ.Attributes{"type": "email"})
				@ui.Checkbox("admin", "Administrator", f.Bool("admin"))
				<div class="flex gap-2">
					@ui.Button("primary", templ.Attributes{"type": "submit"}) {
						Create user
					}
					@ui.LinkButton("ghost", "/admin/users") {
						Cancel
					}
				</div>
			</form>
		}
	}
}

templ tempPasswordPage(p ui.Page, u db.User, password string, created bool) {
	@ui.Layout(p) {
		if created {
			@ui.PageHeader("User created", "@"+u.Username+" can sign in with this temporary password.")
		} else {
			@ui.PageHeader("Password reset", "@"+u.Username+" can sign in with this temporary password.")
		}
		@ui.Card("max-w-lg") {
			<p class="mb-2 text-sm text-muted">Copy it now. It won't be shown again. Ask them to change it in Settings after signing in.</p>
			<p class="rounded-md border border-line bg-surface-2 px-3 py-2 font-mono text-lg select-all" data-temp-password>{ password }</p>
			<div class="mt-4">
				@ui.LinkButton("secondary", "/admin/users") {
					Back to users
				}
			</div>
		}
	}
}
