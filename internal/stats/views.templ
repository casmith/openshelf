package stats

import (
	"strconv"

	"github.com/casmith/openshelf/internal/reviews"
	"github.com/casmith/openshelf/internal/web/ui"
)

templ page(p ui.Page, s Stats) {
	@ui.Layout(p) {
		@content(s)
	}
}

func periodTabs(p Period) []ui.Tab {
	return []ui.Tab{
		{Label: "This year", Href: "/stats", Active: p.Key == "this-year"},
		{Label: "Last year", Href: "/stats?period=last-year", Active: p.Key == "last-year"},
		{Label: "All time", Href: "/stats?period=all", Active: p.Key == "all"},
	}
}

func yearValue(p Period) string {
	if p.Key == "year" {
		return strconv.Itoa(p.Year)
	}
	return ""
}

templ content(s Stats) {
	<div id="stats">
		@ui.PageHeader("Statistics", s.Period.Label()) {
			<form method="get" action="/stats" class="flex items-end gap-2">
				<label for="stats-year" class="sr-only">Year</label>
				<input id="stats-year" type="number" name="year" min="1900" max="9999" placeholder="Year" value={ yearValue(s.Period) } class="w-28 rounded-md border border-line bg-surface px-3 py-2 text-sm placeholder:text-muted focus:border-accent focus:outline-none"/>
				@ui.Button("secondary", templ.Attributes{"type": "submit"}) {
					Show year
				}
			</form>
		}
		@ui.Tabs(periodTabs(s.Period))
		if s.Empty() {
			@ui.EmptyState("No stats for this period", "Finish something, log progress, or rate an item and it will show up here.")
		} else {
			<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
				@tile("check", strconv.Itoa(s.Completed), "Completed")
				@tile("journal", thousands(s.Hours())+" h", "Time logged")
				@tile("book", thousands(s.Pages), "Pages read")
				@ratingTile(s)
			</div>
			<div class="mt-6 grid gap-6 lg:grid-cols-2">
				@kindCard(s)
				@ratingsCard(s)
				<div class="lg:col-span-2">
					@timelineCard(s)
				</div>
				@genresCard(s)
			</div>
		}
	</div>
}

templ tile(icon, value, label string) {
	@ui.Card("") {
		@ui.Icon(icon, "h-5 w-5 text-accent")
		<p class="mt-3 text-2xl font-semibold">{ value }</p>
		<p class="text-sm text-muted">{ label }</p>
	}
}

templ ratingTile(s Stats) {
	@ui.Card("") {
		@ui.Icon("star", "h-5 w-5 text-accent")
		<p class="mt-3 text-2xl font-semibold" data-testid="avg-rating">
			if s.AvgRating != nil {
				@reviews.RatingDisplay(s.Display, s.AvgRating)
			} else {
				–
			}
		</p>
		<p class="text-sm text-muted">Avg. rating · { strconv.Itoa(s.RatedCount) } rated</p>
	}
}

templ cardTitle(text string) {
	<h2 class="mb-4 font-semibold">{ text }</h2>
}

templ dataTable(caption string) {
	<details class="mt-4 text-sm">
		<summary class="cursor-pointer text-muted hover:text-fg">Data table</summary>
		<div class="mt-2">
			@ui.Table() {
				<caption class="sr-only">{ caption }</caption>
				{ children... }
			}
		</div>
	</details>
}

templ swatch(class string) {
	<span class={ "inline-block h-3 w-3 shrink-0 rounded-sm", class } aria-hidden="true"></span>
}

templ kindCard(s Stats) {
	@ui.Card("") {
		@cardTitle("Completed by media type")
		if s.Completed == 0 {
			<p class="text-sm text-muted">Nothing completed in this period.</p>
		} else {
			<div class="flex flex-col items-center gap-6 sm:flex-row">
				<svg viewBox="0 0 42 42" class="h-44 w-44 shrink-0" role="img" aria-label={ "Completed by media type, " + strconv.Itoa(s.Completed) + " total" }>
					<circle cx="21" cy="21" r={ f2(donutR) } fill="none" stroke-width="5" class="stroke-surface-2"></circle>
					for _, seg := range donutSegments(s) {
						<circle cx="21" cy="21" r={ f2(donutR) } fill="none" stroke-width="5" stroke-dasharray={ seg.DashArray } stroke-dashoffset={ seg.DashOffset } class={ seg.Class }>
							<title>{ seg.Title }</title>
						</circle>
					}
					<text x="21" y="21" text-anchor="middle" font-size="8" font-weight="600" class="fill-fg">{ strconv.Itoa(s.Completed) }</text>
					<text x="21" y="26.5" text-anchor="middle" font-size="3.2" class="fill-muted">Completed</text>
				</svg>
				<ul class="w-full space-y-2 text-sm">
					for _, k := range s.ByKind {
						<li class="flex items-center gap-2">
							@swatch(kindStyles[k.Kind].Swatch)
							<span>{ kindLabel(k.Kind) }</span>
							<span class="ml-auto tabular-nums text-muted">{ strconv.Itoa(k.Count) } ({ pct(k.Count, s.Completed) })</span>
						</li>
					}
				</ul>
			</div>
			@dataTable("Completed items by media type") {
				<thead><tr><th scope="col">Type</th><th scope="col">Completed</th><th scope="col">Share</th></tr></thead>
				<tbody>
					for _, k := range s.ByKind {
						<tr><th scope="row">{ kindLabel(k.Kind) }</th><td>{ strconv.Itoa(k.Count) }</td><td>{ pct(k.Count, s.Completed) }</td></tr>
					}
				</tbody>
			}
		}
	}
}

templ bars(c barChart) {
	<svg viewBox="0 0 640 200" class="h-auto w-full" role="img" aria-label={ c.Label }>
		for _, t := range c.Ticks {
			<line x1={ c.Left } x2={ c.Right } y1={ t.Y } y2={ t.Y } stroke-width="1" class="stroke-line"></line>
			<text x="30" y={ t.Y } text-anchor="end" dominant-baseline="middle" font-size="11" class="fill-muted">{ t.Label }</text>
		}
		for _, r := range c.Rects {
			<rect x={ r.X } y={ r.Y } width={ r.W } height={ r.H } rx="2" class={ r.Class }>
				<title>{ r.Title }</title>
			</rect>
		}
		for _, l := range c.XLabels {
			<text x={ l.X } y="192" text-anchor="middle" font-size="11" class="fill-muted">{ l.Label }</text>
		}
	</svg>
}

templ timelineCard(s Stats) {
	@ui.Card("") {
		@cardTitle("Completions per " + timelineUnit(s))
		if s.Completed == 0 {
			<p class="text-sm text-muted">Nothing completed in this period.</p>
		} else {
			<ul class="mb-3 flex flex-wrap gap-4 text-sm">
				for _, k := range Kinds {
					<li class="flex items-center gap-2">
						@swatch(kindStyles[k].Swatch)
						{ kindLabel(k) }
					</li>
				}
			</ul>
			@bars(timelineChart(s))
			@dataTable("Completions per " + timelineUnit(s) + " by media type") {
				<thead>
					<tr>
						<th scope="col">Period</th>
						for _, k := range Kinds {
							<th scope="col">{ kindLabel(k) }</th>
						}
						<th scope="col">Total</th>
					</tr>
				</thead>
				<tbody>
					for _, b := range s.Timeline {
						<tr>
							<th scope="row">{ b.Long }</th>
							for _, k := range Kinds {
								<td>{ strconv.Itoa(b.ByKind[k]) }</td>
							}
							<td>{ strconv.Itoa(b.Total) }</td>
						</tr>
					}
				</tbody>
			}
		}
	}
}

templ ratingsCard(s Stats) {
	@ui.Card("") {
		@cardTitle("Ratings")
		if s.RatedCount == 0 {
			<p class="text-sm text-muted">No ratings in this period.</p>
		} else {
			@bars(ratingChart(s))
			@dataTable("Rating distribution") {
				<thead><tr><th scope="col">Rating</th><th scope="col">Items</th></tr></thead>
				<tbody>
					for _, b := range s.Distribution {
						<tr><th scope="row">{ b.Label }</th><td>{ strconv.Itoa(b.Count) }</td></tr>
					}
				</tbody>
			}
		}
	}
}

templ genresCard(s Stats) {
	@ui.Card("") {
		@cardTitle("Top genres")
		if len(s.Genres) == 0 {
			<p class="text-sm text-muted">No genres for items completed in this period.</p>
		} else {
			<ol class="space-y-2 text-sm" aria-label="Top genres by completed items">
				for _, g := range s.Genres {
					<li class="grid grid-cols-[8rem_1fr_2.5rem] items-center gap-3">
						<span class="truncate capitalize">{ g.Name }</span>
						<svg viewBox="0 0 100 8" preserveAspectRatio="none" class="h-2 w-full" aria-hidden="true">
							<rect width="100" height="8" class="fill-surface-2"></rect>
							<rect width={ genreWidth(g, s) } height="8" class="fill-accent"></rect>
						</svg>
						<span class="text-right tabular-nums text-muted">{ strconv.Itoa(g.Count) }</span>
					</li>
				}
			</ol>
		}
	}
}
