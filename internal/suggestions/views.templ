package suggestions

import (
	"math"
	"strconv"
	"time"

	"github.com/casmith/openshelf/internal/achievements"
	"github.com/casmith/openshelf/internal/db"
	"github.com/casmith/openshelf/internal/images"
	"github.com/casmith/openshelf/internal/web/ui"
)

func itemURL(s Suggestion) string { return "/items/" + s.PublicID.String() }

func actionURL(s Suggestion, a string) string { return pagePath + "/" + s.PublicID.String() + "/" + a }

func evidenceLine(s Suggestion, loc *time.Location) string {
	line := s.Evidence.Name
	if s.Evidence.Description != "" {
		line += " — " + s.Evidence.Description
	}
	if s.Evidence.At != nil {
		line += " · unlocked " + s.Evidence.At.In(loc).Format("Jan 2, 2006")
	}
	return line
}

func playtime(minutes int) string {
	if minutes < 60 {
		return strconv.Itoa(minutes) + " min"
	}
	h := float64(minutes) / 60
	if h >= 10 {
		return strconv.Itoa(int(h+0.5)) + " h"
	}
	return strconv.FormatFloat(h, 'f', 1, 64) + " h"
}

func levelName(l achievements.Level) string {
	switch l {
	case achievements.Strong:
		return "strong"
	case Maybe:
		return "maybe"
	}
	return "medium"
}

func listenedLine(s Suggestion, loc *time.Location) string {
	if s.Level != achievements.Strong {
		return "You listened to " + strconv.Itoa(int(math.Floor(s.Fraction*100))) + "%"
	}
	line := "Audiobookshelf says you finished this"
	if day := FinishDay(s, loc); day != nil {
		line += " · " + day.Format("Jan 2, 2006")
	}
	return line
}

func playtimeLine(s Suggestion) string {
	return "You played " + ui.Hours(int32(s.Minutes)) + " · most players finish the main story in " + ui.Hours(int32(s.Normally))
}

// Link is the compact "N games look finished" entry point; it renders nothing for none.
templ Link(t Tally) {
	if n := t.Total(); n > 0 {
		<a href={ templ.SafeURL(pagePath) } class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline" data-suggestions-count={ strconv.Itoa(n) }>
			@ui.Icon("check", "h-4 w-4")
			if n == 1 {
				1 { t.noun() } looks finished
			} else {
				{ plural(n, t.noun()) } look finished
			}
		</a>
	}
}

templ page(p ui.Page, v pageView) {
	@ui.Layout(p) {
		@ui.PageHeader("Possibly finished", "Based on your Steam achievements, playtime, and Audiobookshelf progress. Nothing is marked until you confirm.") {
			if len(v.Strong) > 0 {
				@ui.LinkButton("secondary", pagePath+"/all") {
					Mark all strong as finished
				}
			}
		}
		<div class="max-w-3xl space-y-8">
			if !v.HasAccounts {
				@ui.EmptyState("No linked accounts", "Link a Steam or Audiobookshelf account to get suggestions from your achievements and listening.") {
					@ui.LinkButton("secondary", "/settings/connections") {
						Connections
					}
				}
			} else if len(v.Strong) == 0 && len(v.Medium) == 0 && len(v.Maybe) == 0 {
				@ui.EmptyState("Nothing to suggest", "Nothing unfinished in your synced games or audiobooks looks finished yet.")
			} else {
				@group("Strong signals", "An achievement that marks the ending, or Audiobookshelf says it's finished.", v.Strong, v.Loc)
				@group("Possible", "Every achievement unlocked, a completion that may not be the main story, or nearly all of an audiobook.", v.Medium, v.Loc)
				if len(v.Maybe) > 0 {
					<details data-maybe-group>
						<summary class="cursor-pointer">
							<h2 class="inline font-semibold">Maybe <span class="font-normal text-muted">({ strconv.Itoa(len(v.Maybe)) })</span></h2>
							<p class="text-sm text-muted">You've played about as long as most players take to finish the main story.</p>
						</summary>
						<ul class="mt-3 space-y-3">
							for _, s := range v.Maybe {
								@card(s, v.Loc)
							}
						</ul>
					</details>
				}
			}
		</div>
	}
}

templ group(title, hint string, ss []Suggestion, loc *time.Location) {
	if len(ss) > 0 {
		<section class="space-y-3">
			<div>
				<h2 class="font-semibold">{ title }</h2>
				<p class="text-sm text-muted">{ hint }</p>
			</div>
			<ul class="space-y-3">
				for _, s := range ss {
					@card(s, loc)
				}
			</ul>
		</section>
	}
}

templ card(s Suggestion, loc *time.Location) {
	<li class="flex gap-4 rounded-lg border border-line bg-surface p-4" data-suggestion={ s.PublicID.String() } data-level={ levelName(s.Level) }>
		<a href={ templ.SafeURL(itemURL(s)) } class="block w-16 shrink-0">
			<div class="aspect-[2/3] overflow-hidden rounded-md border border-line bg-surface-2">
				<img src={ images.CoverURL(s.CoverImageID, s.Kind, images.Thumb) } alt="" loading="lazy" class="h-full w-full object-cover"/>
			</div>
		</a>
		<div class="min-w-0 flex-1">
			<a href={ templ.SafeURL(itemURL(s)) } class="flex items-center gap-2 font-medium hover:text-accent">
				@ui.KindIcon(string(s.Kind), "h-4 w-4 text-muted")
				{ s.Title }
			</a>
			if s.Listened {
				<p class="mt-1 text-sm" data-evidence>{ listenedLine(s, loc) }</p>
				if s.Level == achievements.Medium && s.FinishAt != nil {
					<p class="text-sm text-muted" data-dated>Dated to when you last listened ({ FinishDay(s, loc).Format("Jan 2, 2006") }).</p>
				}
			} else if s.Level == Maybe {
				<p class="mt-1 text-sm" data-evidence>{ playtimeLine(s) }</p>
				if s.FinishAt != nil {
					<p class="text-sm text-muted" data-dated>Dated to when you last played ({ FinishDay(s, loc).Format("Jan 2, 2006") }).</p>
				}
			} else if s.AllUnlocked {
				<p class="mt-1 text-sm">All achievements unlocked</p>
				<p class="text-sm text-muted">Latest: { evidenceLine(s, loc) }</p>
			} else {
				<p class="mt-1 text-sm" data-evidence>{ evidenceLine(s, loc) }</p>
			}
			if s.Level == achievements.Medium && !s.Listened && s.FinishAt != nil {
				<p class="text-sm text-muted" data-dated>Dated to your last achievement, { FinishDay(s, loc).Format("Jan 2, 2006") }.</p>
			}
			if s.Level != Maybe && !s.Listened {
				<p class="mt-1 text-xs text-muted">
					Achievements { strconv.Itoa(s.Unlocked) }/{ strconv.Itoa(s.Total) }
					if s.Minutes > 0 {
						· { playtime(s.Minutes) } played
					}
				</p>
			}
			<div class="mt-3 flex flex-wrap gap-2">
				if s.FinishAt != nil {
					@actionForm(s, "finish", "primary") {
						Mark finished
					}
				}
				@actionForm(s, "finish-undated", "secondary") {
					Finished, date unknown
				}
				@actionForm(s, "dismiss", "ghost") {
					Not finished
				}
			</div>
		</div>
	</li>
}

templ actionForm(s Suggestion, a, variant string) {
	<form method="post" action={ templ.SafeURL(actionURL(s, a)) } hx-post={ actionURL(s, a) } hx-target="closest li" hx-swap="outerHTML">
		@ui.Button(variant, templ.Attributes{"type": "submit"}) {
			{ children... }
		}
	</form>
}

templ confirmPage(p ui.Page, strong []Suggestion, loc *time.Location) {
	@ui.Layout(p) {
		@ui.PageHeader("Mark all strong as finished", "Each is logged as finished on the day of its evidence: the ending achievement, or the Audiobookshelf finish.") {
			@ui.LinkButton("ghost", pagePath) {
				Cancel
			}
		}
		@ui.Card("max-w-2xl space-y-4") {
			if len(strong) == 0 {
				<p class="text-sm text-muted">There are no strong suggestions right now.</p>
			} else {
				<ul class="list-disc space-y-1 pl-5 text-sm">
					for _, s := range strong {
						<li data-confirm={ s.PublicID.String() }>
							<span class="font-medium">{ s.Title }</span>
							if day := FinishDay(s, loc); day != nil {
								<span class="text-muted">· { day.Format("Jan 2, 2006") }</span>
							} else {
								<span class="text-muted">· date unknown</span>
							}
						</li>
					}
				</ul>
				<form method="post" action={ templ.SafeURL(pagePath + "/all") }>
					@ui.Button("primary", templ.Attributes{"type": "submit"}) {
						Mark { plural(len(strong), tally(strong).noun()) } as finished
					}
				</form>
			}
		}
	}
}

templ itemPanel(item db.MediaItem, s Suggestion) {
	<div class="rounded-lg border border-line bg-surface px-5 py-3 text-sm" id="finish-suggestion">
		if s.Listened && s.Level == achievements.Strong {
			Audiobookshelf says you finished this —
		} else if s.Listened {
			{ listenedLine(s, nil) } on Audiobookshelf —
		} else if s.Level == Maybe {
			Your Steam playtime suggests you may have finished this —
		} else {
			Steam suggests you finished this —
		}
		<form method="post" action={ templ.SafeURL(pagePath + "/" + item.PublicID.String() + "/finish") } class="inline">
			<input type="hidden" name="next" value={ "/items/" + item.PublicID.String() }/>
			<button type="submit" class="font-medium text-accent hover:underline">Mark finished</button>
		</form>
	</div>
}
